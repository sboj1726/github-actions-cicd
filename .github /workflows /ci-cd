name: CI-CD

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]

jobs:
  test-and-build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Validate
        run: python -m py_compile app.py

      - name: Unit tests
        run: python -m unittest discover -v

      - name: Docker build
        run: docker build -t devops-demo:${{ github.sha }} .
